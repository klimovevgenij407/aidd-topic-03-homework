# Django
DJANGO_SECRET_KEY=dev-insecure-secret-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO
# DJANGO_LOG_FILE=logs/app.log

# Database: sqlite (default) or postgresql
DB_ENGINE=sqlite
# SQLITE_PATH=/absolute/path/to/db.sqlite3
# POSTGRES_DB=investing
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Market data: auto (T-Invest if token is set, otherwise simulated),
# simulated, or tinkoff.
MARKET_DATA_PROVIDER=auto
TINKOFF_TOKEN=
MARKET_DATA_HISTORY_DAYS=180

# Celery / Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# E-mail notifications for watchlists (console backend by default)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@investing.local
WATCHLIST_EMAIL_NOTIFICATIONS=false
