# Copy to .env and adjust. Never commit real credentials.

DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Set true only behind HTTPS in production.
DJANGO_SECURE_SSL=false

# sqlite (default, no services required) or postgres
DATABASE_ENGINE=sqlite
POSTGRES_DB=investing
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# T-Bank Invest API. Empty token => synthetic demo provider.
TINKOFF_INVEST_TOKEN=
# auto | tbank | synthetic
MARKET_DATA_PROVIDER=auto
MARKET_DATA_HISTORY_DAYS=180

# Celery. Redis is required for real workers/beat.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# In-app notifications are always created; optional e-mail copy.
ALERTS_EMAIL_ENABLED=false
